            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Trạng thái thao tác.",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "WAITING",
                "SUCCESS",
                "FAILED",
                "TIMEOUT"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Trang hiện tại; giá trị không hợp lệ được đưa về 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
