                "co2",
                "ch4"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Tìm thời gian bắt đầu, bỏ khoảng trắng hai đầu.",
            "schema": {
              "type": "string",
              "default": "",
              "example": "8/11/2026"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Trang hiện tại; giá trị không hợp lệ được đưa về 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "items",
            "in": "query",
            "required": false,
            "description": "Số bản ghi mỗi trang; không giới hạn vào 10/20/50. Giá trị không hợp lệ được đưa về 10, số âm về 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Chỉ ASC cho thứ tự tăng dần, còn lại dùng DESC; sắp theo thời gian rồi ID.",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          }
        ]
      }
    }
  }
