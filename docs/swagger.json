{
  "openapi": "3.0.0",
  "info": {
    "title": "IoT API",
    "version": "1.0.0",
    "description": "Tài liệu toàn bộ endpoint /api. Đăng nhập qua /login cùng origin trước khi Try it out; trình duyệt tự gửi cookie accessToken. Các API dữ liệu và điều khiển đều yêu cầu quyền admin. Ngày giờ JSON theo ISO 8601; tìm kiếm thời gian và thống kê ngày dùng UTC+07."
  },
  "servers": [
    {
      "url": "/",
      "description": "Cùng origin với Swagger UI"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Đăng nhập và đăng xuất"
    },
    {
      "name": "Sensors",
      "description": "Dữ liệu cảm biến"
    },
    {
      "name": "Devices",
      "description": "Trạng thái và điều khiển thiết bị"
    },
    {
      "name": "Actions",
      "description": "Lịch sử điều khiển"
    },
    {
      "name": "Alerts",
      "description": "Dashboard khí và lịch sử cảnh báo"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Cookie JWT do /api/auth/login đặt; đăng nhập cùng origin, trình duyệt gửi tự động."
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Thông báo lỗi"
          }
        }
      },
      "AuthMessage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Đăng nhập thành công"
          }
        }
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "type": {
            "type": "string",
            "example": "Temperature"
          },
          "name": {
            "type": "string",
            "example": "Cảm biến nhiệt độ"
          }
        }
      },
      "SensorData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 301,
            "format": "int64"
          },
          "sensor_id": {
            "type": "integer",
            "example": 1
          },
          "value": {
            "type": "number",
            "example": 30.5
          },
          "measurement_type": {
            "type": "string",
            "enum": [
              "Temperature",
              "Humidity",
              "Light",
              "N2",
              "CO2",
              "CH4"
            ],
            "example": "N2"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T08:30:00.000Z"
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Quạt"
          },
          "current_status": {
            "type": "string",
            "enum": [
              "ON",
              "OFF"
            ],
            "example": "OFF"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T08:30:00.000Z"
          }
        }
      },
      "ActionHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 123,
            "format": "int64"
          },
          "device_id": {
            "type": "integer",
            "example": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "ON",
              "OFF"
            ],
            "example": "ON"
          },
          "status": {
            "type": "string",
            "enum": [
              "WAITING",
              "SUCCESS",
              "FAILED",
              "TIMEOUT"
            ],
            "example": "WAITING"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T08:30:00.000Z"
          },
          "device": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "name": {
                "type": "string",
                "example": "Quạt"
              }
            },
            "nullable": true
          }
        }
      },
      "AlertHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1,
            "format": "int64"
          },
          "alert_device_id": {
            "type": "integer",
            "example": 1
          },
          "threshold_value": {
            "type": "number",
            "example": 50
          },
          "peak_value": {
            "type": "number",
            "example": 82
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T08:30:00.000Z"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T08:30:10.000Z"
          },
          "sensor": {
            "type": "string",
            "enum": [
              "n2",
              "co2",
              "ch4"
            ],
            "description": "Được bổ sung khi alert_device_id là 1, 2 hoặc 3.",
            "example": "n2"
          }
        }
      },
      "GasSnapshot": {
        "type": "object",
        "properties": {
          "sensor": {
            "type": "string",
            "enum": [
              "n2",
              "co2",
              "ch4"
            ],
            "example": "n2"
          },
          "alertDeviceId": {
            "type": "integer",
            "example": 1
          },
          "value": {
            "type": "number",
            "example": 82,
            "nullable": true
          },
          "threshold": {
            "type": "number",
            "example": 50
          },
          "unit": {
            "type": "string",
            "enum": [
              "%",
              "ppm"
            ],
            "example": "%"
          },
          "isBlinking": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "string",
            "example": "alert"
          },
          "totalAlerts": {
            "type": "integer",
            "example": 12,
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SensorData"
            },
            "maxItems": 5,
            "description": "Tối đa 5 bản ghi mới nhất, trả theo thứ tự thời gian tăng dần."
          }
        }
      },
      "SensorDataWithSensor": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SensorData"
          },
          {
            "type": "object",
            "properties": {
              "sensor": {
                "$ref": "#/components/schemas/Sensor",
                "nullable": true
              }
            }
          }
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Thiếu cookie, token hết hạn/không hợp lệ hoặc không có quyền admin.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthMessage"
            },
            "example": {
              "code": "unauthorized",
              "message": "Vui lòng đăng nhập để điều khiển thiết bị"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng nhập quản trị",
        "description": "Kiểm tra ADMIN_USERNAME/ADMIN_PASSWORD. Thành công đặt cookie accessToken (JWT HS256), HttpOnly, SameSite=Strict, thời hạn 2 giờ, Secure ở production. Đăng nhập tại /login trên cùng origin với Swagger để trình duyệt tự gửi cookie; Swagger UI không thể tự đặt cookie HttpOnly qua Authorize.",
        "operationId": "postApiAuthLogin",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "accessToken=<JWT>; Path=/; HttpOnly; SameSite=Strict; Max-Age=7200 (Secure ở production).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Thiếu tài khoản/mật khẩu hoặc sai kiểu dữ liệu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                },
                "example": {
                  "code": "error",
                  "message": "Vui lòng nhập tài khoản và mật khẩu"
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin đăng nhập.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "Sai tài khoản hoặc mật khẩu"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng xuất",
        "description": "Xóa cookie accessToken tại path /. Không yêu cầu đăng nhập.",
        "operationId": "postApiAuthLogout",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                },
                "example": {
                  "code": "success",
                  "message": "Đã đăng xuất"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/sensors-data/latest": {
      "get": {
        "tags": [
          "Sensors"
        ],
        "summary": "Lấy dữ liệu mới nhất của 3 cảm biến thật",
        "description": "Mỗi loại Temperature, Humidity, Light tối đa 10 bản ghi; thời gian giảm dần rồi ID giảm dần. Không trả N2/CO2/CH4 ở endpoint này.",
        "operationId": "getApiSensorsDataLatest",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "Temperature": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SensorData"
                      }
                    },
                    "Humidity": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SensorData"
                      }
                    },
                    "Light": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SensorData"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi xử lý máy chủ; message theo controller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/api/sensors-data": {
      "get": {
        "tags": [
          "Sensors"
        ],
        "summary": "Tìm kiếm và phân trang dữ liệu cảm biến",
        "description": "ALL tìm một phần giá trị, loại cảm biến hoặc thời gian. Time chỉ tìm thời gian. Loại cụ thể lọc measurement_type và tìm một phần giá trị. Thời gian tìm theo UTC+07 với định dạng D/MM/YYYY HH:mm:ss; ngày không đệm số 0. Trang vượt tổng trang trả mảng rỗng.",
        "operationId": "getApiSensorsData",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SensorDataWithSensor"
                      }
                    },
                    "currentPage": {
                      "type": "integer",
                      "example": 1
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "totalItems": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "skip": {
                      "type": "integer",
                      "example": 0,
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi xử lý máy chủ; message theo controller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Từ khóa tìm kiếm; bỏ khoảng trắng hai đầu.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "searchBy",
            "in": "query",
            "required": false,
            "description": "Phạm vi tìm kiếm; loại cụ thể được so khớp measurement_type.",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "Temperature",
                "Humidity",
                "Light",
                "N2",
                "CO2",
                "CH4",
                "Time"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Trang hiện tại; giá trị không hợp lệ được đưa về 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "items",
            "in": "query",
            "required": false,
            "description": "Số bản ghi mỗi trang; không giới hạn vào 10/20/50. Giá trị không hợp lệ được đưa về 10, số âm về 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Chỉ ASC cho thứ tự tăng dần, còn lại dùng DESC; sắp theo thời gian rồi ID.",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          }
        ]
      }
    },
    "/api/devices/status": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Lấy trạng thái thiết bị",
        "description": "Trả toàn bộ thiết bị trong CSDL, không bảo đảm thứ tự.",
        "operationId": "getApiDevicesStatus",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi xử lý máy chủ; message theo controller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{id}/control": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Gửi lệnh bật/tắt thiết bị",
        "description": "Tạo lịch sử WAITING, publish device/{id}/command với action và action_id, retain=false. HTTP 200 chỉ xác nhận đã gửi lệnh MQTT. Chờ thiết bị xác nhận; quá 5 giây còn WAITING thì chuyển TIMEOUT. Publish lỗi chuyển FAILED.",
        "operationId": "postApiDevicesIdControl",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Đã gửi lệnh, đang chờ thiết bị phản hồi."
                    },
                    "action_id": {
                      "type": "integer",
                      "example": 123,
                      "format": "int64"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "400": {
            "description": "Lệnh không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Lệnh phải là ON hoặc OFF."
                }
              }
            }
          },
          "404": {
            "description": "Không có thiết bị.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Không tìm thấy thiết bị."
                }
              }
            }
          },
          "503": {
            "description": "MQTT chưa kết nối.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "MQTT chưa kết nối."
                }
              }
            }
          },
          "500": {
            "description": "Gửi MQTT thất bại hoặc lỗi máy chủ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Gửi lệnh MQTT thất bại."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID thiết bị trong bảng devices.",
            "schema": {
              "type": "integer",
              "example": 1,
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "ON",
                      "OFF"
                    ],
                    "example": "ON"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        }
      }
    },
    "/api/actions-history": {
      "get": {
        "tags": [
          "Actions"
        ],
        "summary": "Tìm kiếm lịch sử điều khiển",
        "description": "Tìm một phần tên thiết bị, action, status hoặc thời gian tạo theo UTC+07 (D/MM/YYYY HH:mm:ss). Kết hợp bộ lọc device và status bằng AND.",
        "operationId": "getApiActionsHistory",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActionHistory"
                      }
                    },
                    "currentPage": {
                      "type": "integer",
                      "example": 1
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "skip": {
                      "type": "integer",
                      "example": 0,
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi tải lịch sử.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                },
                "example": {
                  "code": "error",
                  "message": "Không tải được lịch sử thao tác."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Từ khóa tìm kiếm.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "device",
            "in": "query",
            "required": false,
            "description": "ALL hoặc chuỗi ID thiết bị, ví dụ 1.",
            "schema": {
              "type": "string",
              "default": "ALL",
