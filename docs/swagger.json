    "/api/gas-dashboard": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Lấy dữ liệu dashboard khí",
        "description": "Mỗi thiết bị cảnh báo có giá trị mới nhất, trạng thái nháy, tổng lịch sử mọi ngày và tối đa 5 mẫu. Thiết bị sắp theo ID tăng dần. value=null, records=[] nếu chưa có mẫu. Ngưỡng hiện tại: N2=50 %, CO2=700 ppm, CH4=450 ppm.",
        "operationId": "getApiGasDashboard",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GasSnapshot"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi xử lý máy chủ; message theo controller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts/daily": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Đếm cảnh báo theo ngày",
        "description": "Ngày được tính theo UTC+07: từ 00:00 ngày chọn đến trước 00:00 ngày sau. Đếm theo started_at của bản ghi trong alert_history, không theo ended_at. Trả từng thiết bị cảnh báo theo ID, kể cả count=0.",
        "operationId": "getApiAlertsDaily",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-11-08"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sensor": {
                            "type": "string",
                            "enum": [
                              "n2",
                              "co2",
                              "ch4"
                            ],
                            "example": "n2"
                          },
                          "count": {
                            "type": "integer",
                            "example": 3,
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "400": {
            "description": "Thiếu ngày, sai định dạng hoặc ngày không tồn tại.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Ngày không hợp lệ."
                }
              }
            }
          },
          "500": {
            "description": "Lỗi tải thống kê.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Không tải được thống kê cảnh báo."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Bắt buộc YYYY-MM-DD và phải là ngày tồn tại.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-11-08"
            }
          }
        ]
      }
    },
    "/api/alerts/history": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Tìm kiếm lịch sử cảnh báo",
        "description": "Lọc n2/co2/ch4 lần lượt theo alert_device_id=1/2/3; ALL hoặc giá trị khác không lọc. search tìm một phần started_at theo UTC+07 dạng D/MM/YYYY HH:mm:ss. Không có tham số date hay lọc khoảng ngày.",
        "operationId": "getApiAlertsHistory",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AlertHistory"
                      }
                    },
                    "currentPage": {
                      "type": "integer",
                      "example": 1
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "example": 1,
                      "minimum": 0
                    },
                    "skip": {
                      "type": "integer",
                      "example": 0,
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Lỗi tải lịch sử.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessage"
                },
                "example": {
                  "code": "error",
                  "message": "Không tải được lịch sử cảnh báo."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sensor",
            "in": "query",
            "required": false,
            "description": "Loại cảm biến cảnh báo.",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
